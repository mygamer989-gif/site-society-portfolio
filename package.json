{
  "name": "site-society-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "SITE SOCIETY — Luxury Digital Studio Portfolio & Secure Admin Platform on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply site-society-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply site-society-db --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
