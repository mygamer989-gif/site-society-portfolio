# Copy to .dev.vars for local development (NEVER commit .dev.vars)
# Generate strong random strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

ADMIN_SETUP_TOKEN=replace-with-one-time-setup-token
SESSION_SECRET=replace-with-64-char-random-hex-secret

# Optional: Cloudflare Turnstile keys for the public contact form
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical domain (update once you attach a custom domain)
CANONICAL_URL=https://site-society.workers.dev
